{
	"name": "r4",
	"version": "0.0.1",
	"repository": "https://github.com/radio4000/r4-svelte",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:standalone": "PUBLIC_APP_MODE=standalone vite build",
		"preview": "vite preview",
		"format": "prettier --write . --log-level=warn",
		"biome": "biome check --write .",
		"lint": "eslint .",
		"check": "bun run format && bun run biome && bun run lint",
		"knip": "knip-bun",
		"types": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"bench": "bun perf/bench.ts",
		"i18n": "node i18n/sync.js && bunx @inlang/paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
		"i18n:stats": "node i18n/stats.js",
		"i18n:extract": "node i18n/extract.js",
		"i18n:review": "node i18n/review.js",
		"i18n:check": "node i18n/check.js",
		"i18n:prune-unused": "node i18n/prune-unused.js",
		"i18n:apply": "node i18n/apply-batch.js"
	},
	"overrides": {
		"vite": "^8.1.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@e18e/eslint-plugin": "^0.8.1",
		"@eslint/js": "^10",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tanstack/eslint-plugin-query": "^5.104.4",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24",
		"@types/youtube": "^0.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"knip": "^6.42.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@humanspeak/svelte-virtual-list": "^0.5.15",
		"@inlang/paraglide-js": "^2.29.0",
		"@inlang/plugin-m-function-matcher": "^2.3.4",
		"@inlang/plugin-message-format": "^4.5.4",
		"@radio4000/sdk": "^0.8.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@tanstack/query-core": "^5.104.4",
		"@tanstack/query-db-collection": "^1.4.7",
		"@tanstack/query-persist-client-core": "^5.104.4",
		"@tanstack/svelte-db": "^0.5.11",
		"@tanstack/svelte-query": "^6.3.4",
		"@tanstack/svelte-query-devtools": "^6.3.4",
		"adze": "^2.3.0",
		"feed": "^6.0.0",
		"fuzzysort": "^4.0.2",
		"gsap": "^3.15.0",
		"idb-keyval": "^6.3.0",
		"lil-gui": "^0.21.0",
		"luxon": "^3.7.2",
		"maplibre-gl": "^6.15.0",
		"marked": "^18.1.1",
		"media-chrome": "^4.19.3",
		"media-now": "^2.2.3",
		"obra-icons-svelte": "^1.25.0",
		"ogl": "^1.0.11",
		"posthog-js": "^1.438.12",
		"runed": "^0.37.1",
		"svelte-awesome-color-picker": "^4.1.3",
		"tinykeys": "^4.0.1",
		"youtube-video-element": "^1.9.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}

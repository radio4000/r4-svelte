{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// Mirrors package.json "imports" so svelte-check --tsgo types .svelte files imported via #lib
		"paths": {"#lib/*": ["./src/lib/*"]},
		"sourceMap": true,
		"strict": true,
		// to relax it a bit
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"types": ["$app/types", "vite-plugin-pwa/client", "youtube"]
	},
	"include": ["src", "vite.config.ts", "tests"]
}
